package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.camera.provider.shim-service",
    relative_install_path: "hw",
    init_rc: ["android.hardware.camera.provider.shim-service.rc"],
    srcs: [
        "service.cpp",
        "CameraProviderShim.cpp",
        "CameraDeviceShim.cpp",
        "CameraDeviceSessionShim.cpp",
    ],
    shared_libs: [
        "android.hardware.camera.provider-V4-ndk",
        "android.hardware.camera.device-V4-ndk",
        "libcamera_metadata",
        "libhardware",
        "libui",
        "libutils",
        "libbase",
        "liblog",
        "libgrallocusage",
        "libbinder_ndk",
        "libcutils",
        "libsync",
    ],
    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-unused-but-set-variable",
    ],
    vendor: true,
}
