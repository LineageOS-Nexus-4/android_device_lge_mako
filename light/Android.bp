cc_binary {
    init_rc: ["android.hardware.lights-service.mako.rc"],
    relative_install_path: "hw",
    name: "android.hardware.lights-service.mako",
    srcs: ["main.cpp", "Light.cpp"],
    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
        "libutils",
        "libbinder_ndk",
        "android.hardware.light-V3-ndk",
    ],
    vendor: true,
    vintf_fragments: ["android.hardware.light.ILights-service-mako.xml"],
}
