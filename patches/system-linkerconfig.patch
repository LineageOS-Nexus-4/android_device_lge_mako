diff --git a/contents/namespace/vendordefault.cc b/contents/namespace/vendordefault.cc
index a866839..1dc49ac 100644
--- a/contents/namespace/vendordefault.cc
+++ b/contents/namespace/vendordefault.cc
@@ -48,6 +48,20 @@ Namespace BuildVendorNamespace([[maybe_unused]] const Context& ctx,
   ns.AddPermittedPath("/odm");
   ns.AddPermittedPath("/vendor");
   ns.AddPermittedPath("/system/vendor");
+  // mako legacy camera HAL (camera.mako.so) lives in /system/lib/hw and
+  // links platform libraries (libcamera_client, libmedia, ...).
+  ns.AddPermittedPath("/system/${LIB}/hw");
+  auto& system_link = ns.GetLink(ctx.GetSystemNamespaceName());
+  for (const std::string& lib : {"libcamera_client.so", "libmedia.so",
+                                 "libcamera_metadata.so", "libui.so",
+                                 "libutils.so", "liblog.so", "libcutils.so",
+                                 "libbinder.so", "libnativewindow.so",
+                                 "libgenlock.so", "libmmcamera_interface.so",
+                                 "libc++.so", "android.hidl.token@1.0-utils.so",
+                                 "android.hardware.graphics.bufferqueue@1.0.so",
+                                 "android.hardware.graphics.bufferqueue@2.0.so"}) {
+    system_link.AddSharedLib(lib);
+  }
 
   ns.GetLink("rs").AddSharedLib("libRS_internal.so");
   ns.AddRequires(base::Split(Var("LLNDK_LIBRARIES_VENDOR", ""), ":"));
