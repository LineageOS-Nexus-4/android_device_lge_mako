--- a/legacy/qcwcn/wcnss-service/Android.mk
+++ b/legacy/qcwcn/wcnss-service/Android.mk
@@ -1,4 +1,4 @@
-ifneq ($(filter msm8916 msm8909,$(TARGET_BOARD_PLATFORM)),)
+ifneq ($(filter msm8916 msm8909 msm8960,$(TARGET_BOARD_PLATFORM)),)
 ifneq (,$(filter arm aarch64 arm64, $(TARGET_ARCH)))
 LOCAL_PATH := $(call my-dir)
 include $(CLEAR_VARS)
@@ -7,8 +7,15 @@ LOCAL_LICENSE_KINDS := SPDX-license-identifier-BSD
 LOCAL_LICENSE_CONDITIONS := notice
 LOCAL_C_INCLUDES += $(TARGET_OUT_HEADERS)/common/inc/
 LOCAL_SRC_FILES := wcnss_service.c
-LOCAL_PROPRIETARY_MODULE := true
-ifeq ($(strip $(TARGET_USES_QCOM_WCNSS_QMI)),true)
+LOCAL_VENDOR_MODULE := true
+# mako (msm8960): the QMI stack (libqmiservices/libmdmdetect) is not in the
+# tree; wcnss firmware load does not need the modem anyway (MAC comes from
+# WCNSS_qcom_wlan_nv.bin), so use the non-QMI path for msm8960.
+WCNSS_USE_QMI := $(strip $(TARGET_USES_QCOM_WCNSS_QMI))
+ifeq ($(TARGET_BOARD_PLATFORM),msm8960)
+WCNSS_USE_QMI := false
+endif
+ifeq ($(strip $(WCNSS_USE_QMI)),true)
 LOCAL_CFLAGS += -DWCNSS_QMI
 LOCAL_C_INCLUDES += $(TARGET_OUT_HEADERS)/qmi/inc
 LOCAL_C_INCLUDES += $(TARGET_OUT_HEADERS)/qmi/services
@@ -18,7 +25,7 @@ LOCAL_C_INCLUDES += $(TARGET_OUT_HEADERS)/qmi/core/lib/inc
 LOCAL_SRC_FILES += wcnss_qmi_client.c
 endif #TARGET_USES_QCOM_WCNSS_QMI
 LOCAL_SHARED_LIBRARIES := libc libcutils libutils liblog
-ifeq ($(strip $(TARGET_USES_QCOM_WCNSS_QMI)),true)
+ifeq ($(strip $(WCNSS_USE_QMI)),true)
 LOCAL_SHARED_LIBRARIES += libqmiservices libqmi libqcci_legacy libqmi_client_qmux
 LOCAL_C_INCLUDES += $(TARGET_OUT_HEADERS)/libmdmdetect/inc
 LOCAL_SHARED_LIBRARIES += libmdmdetect
@@ -27,4 +34,4 @@ LOCAL_MODULE_TAGS := optional
 LOCAL_CFLAGS += -Wall -Wno-error
 include $(BUILD_EXECUTABLE)
 endif
-endif # ifneq ($(filter msm8916 msm8909,$(TARGET_BOARD_PLATFORM)),)
+endif # ifneq ($(filter msm8916 msm8909 msm8960,$(TARGET_BOARD_PLATFORM)),)
