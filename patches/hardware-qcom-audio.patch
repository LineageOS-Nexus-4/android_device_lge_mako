--- a/hal/msm8960/platform.c
+++ b/hal/msm8960/platform.c
@@ -28,6 +28,27 @@
 #include "audio_extn.h"
 
 #define LIB_ACDB_LOADER "libacdbloader.so"
+
+// name_to_index machinery (defined locally in newer platform files; the
+// LOS 18.1 msm8960 variant references it without defining it)
+struct name_to_index {
+    const char *name;
+    int index;
+};
+
+#define TO_NAME_INDEX(X)   #X, X
+
+static int find_index(const struct name_to_index *table, int32_t len, const char *name)
+{
+    int i;
+    if (table == NULL || name == NULL)
+        return -EINVAL;
+    for (i = 0; i < len; i++) {
+        if (table[i].name != NULL && strcmp(name, table[i].name) == 0)
+            return table[i].index;
+    }
+    return -ENODEV;
+}
