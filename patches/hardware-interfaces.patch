--- a/graphics/composer/2.1/utils/hwc2on1adapter/HWC2On1Adapter.cpp
+++ b/graphics/composer/2.1/utils/hwc2on1adapter/HWC2On1Adapter.cpp
@@ -1240,6 +1240,21 @@ bool HWC2On1Adapter::Display::prepare() {
 
     prepareFramebufferTarget();
 
+    // mako bring-up: allocateRequestedContents() zeroes the contents with
+    // calloc() on every prepare, so the HWC1 framebuffer-target layer always
+    // has a NULL handle at prepare time.  The legacy mako HWC1 gates its
+    // FB-update overlay setup on fbLayer->handle, so it never programs the
+    // display and the panel stays black.  Restore the handle/fence that
+    // set() wrote on the previous frame.
+    if (mHwc1RequestedContents && mHwc1RequestedContents->numHwLayers > 0) {
+        auto& fbLayer =
+                mHwc1RequestedContents->hwLayers[mHwc1RequestedContents->numHwLayers - 1];
+        if (fbLayer.compositionType == HWC_FRAMEBUFFER_TARGET) {
+            fbLayer.handle = mClientTarget.getBuffer();
+            fbLayer.acquireFenceFd = mClientTarget.getFence();
+        }
+    }
+
     resetGeometryMarker();
 
     return true;
