diff --git a/bluetooth/1.0/default/vendor_interface.cc b/bluetooth/1.0/default/vendor_interface.cc
index 3ea30a5..109c1d0 100644
--- a/bluetooth/1.0/default/vendor_interface.cc
+++ b/bluetooth/1.0/default/vendor_interface.cc
@@ -359,6 +359,27 @@ void VendorInterface::OnTimeout() {
     recent_activity_flag = false;
 }
 
+// mako (WCN3660) compat: the controller reports READ_REMOTE_SUPPORTED_FEATURES_COMPLETE
+// (0x0b) without the LMP features field when the read fails for a peer. The modern
+// gd stack validates against the full fixed-size packet (status + handle + reserved +
+// 8-byte lmp_features), so pad the short event with zeros before forwarding.
+static hidl_vec<uint8_t> NormalizeMakoEvent(const hidl_vec<uint8_t>& hci_packet) {
+    constexpr uint8_t kReadRemoteSupportedFeaturesComplete = 0x0b;
+    constexpr uint8_t kHciEventPreamble = 2;  // event code + parameter length
+    constexpr size_t kFullPayloadSize = 11;   // status + handle(2) + lmp_features(8)
+    if (hci_packet.size() < kHciEventPreamble + 1) return hci_packet;
+    if (hci_packet[0] != kReadRemoteSupportedFeaturesComplete) return hci_packet;
+    const size_t plen = hci_packet[1];
+    if (plen >= kFullPayloadSize) return hci_packet;
+    hidl_vec<uint8_t> out;
+    out.resize(kHciEventPreamble + kFullPayloadSize);
+    out[0] = kReadRemoteSupportedFeaturesComplete;
+    out[1] = kFullPayloadSize;
+    for (size_t i = 0; i < plen; i++) out[kHciEventPreamble + i] = hci_packet[kHciEventPreamble + i];
+    for (size_t i = plen; i < kFullPayloadSize; i++) out[kHciEventPreamble + i] = 0;
+    return out;
+}
+
 void VendorInterface::HandleIncomingEvent(const hidl_vec<uint8_t>& hci_packet) {
     if (internal_command.cb != nullptr && internal_command_event_match(hci_packet)) {
         HC_BT_HDR* bt_hdr = WrapPacketAndCopy(HCI_PACKET_TYPE_EVENT, hci_packet);
@@ -368,7 +389,7 @@ void VendorInterface::HandleIncomingEvent(const hidl_vec<uint8_t>& hci_packet) {
         internal_command.cb = nullptr;
         saved_cb(bt_hdr);
     } else {
-        event_cb_(hci_packet);
+        event_cb_(NormalizeMakoEvent(hci_packet));
     }
 }
 
