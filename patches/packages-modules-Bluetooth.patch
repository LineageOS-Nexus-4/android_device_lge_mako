diff --git a/system/gd/hci/controller_impl.cc b/system/gd/hci/controller_impl.cc
index e20029f..947aaeb 100644
--- a/system/gd/hci/controller_impl.cc
+++ b/system/gd/hci/controller_impl.cc
@@ -321,7 +321,15 @@ struct ControllerImpl::impl {
     auto complete_view = WriteSecureConnectionsHostSupportCompleteView::Create(view);
     log::assert_that(complete_view.IsValid(), "Complete view is invalid");
     ErrorCode status = complete_view.GetStatus();
-    log::assert_that(status == ErrorCode::SUCCESS, "Status {}", ErrorCodeText(status));
+    // mako bring-up: the WCN3660 controller advertises Secure Connections
+    // support but rejects the write command with UNSUPPORTED_FEATURE; the
+    // fatal assert crash-looped com.android.bluetooth. Tolerate the
+    // failure - SC is simply not enabled and pairing falls back to
+    // legacy SSP.
+    if (status != ErrorCode::SUCCESS) {
+      log::error("WriteSecureConnectionsHostSupport failed: {}",
+                 ErrorCodeText(status));
+    }
   }
 
   void read_local_version_information_complete_handler(CommandCompleteView view) {
diff --git a/system/gd/hci/hci_layer.cc b/system/gd/hci/hci_layer.cc
index fd85769..04bfdf9 100644
--- a/system/gd/hci/hci_layer.cc
+++ b/system/gd/hci/hci_layer.cc
@@ -253,6 +253,33 @@ struct HciLayer::impl {
       common::StopWatch::DumpStopWatchLog();
       return;
     }
+    // mako bring-up: the WCN3660 controller answers unknown vendor
+    // commands with a completion whose opcode is 0xffff ("unknown") even
+    // though the completion carries the error status; treat that exactly
+    // like the command-status UNKNOWN_HCI_COMMAND path below.
+    bool waiting_vendor = (static_cast<int>(waiting_command_) & (0x3f << 10)) == (0x3f << 10);
+    if (waiting_vendor && static_cast<uint16_t>(op_code) == 0xffff && !command_queue_.empty() &&
+        command_queue_.front().waiting_for_ == CommandQueueEntry::WaitingFor::COMPLETE) {
+      auto payload = std::make_unique<packet::RawBuilder>();
+      payload->AddOctets1(static_cast<uint8_t>(ErrorCode::UNKNOWN_HCI_COMMAND));
+      auto complete_event_builder =
+              CommandCompleteBuilder::Create(0 /* num_hci_command_packets */,
+                                             waiting_command_, std::move(payload));
+      auto complete = std::make_shared<std::vector<std::uint8_t>>(
+              complete_event_builder->SerializeToBytes());
+      CommandCompleteView command_complete_view =
+              CommandCompleteView::Create(EventView::Create(PacketView<kLittleEndian>(complete)));
+      log::assert_that(command_complete_view.IsValid(),
+                       "assert failed: command_complete_view.IsValid()");
+      (*command_queue_.front().GetCallback<CommandCompleteView>())(command_complete_view);
+      command_queue_.pop_front();
+      waiting_command_ = OpCode::NONE;
+      if (hci_timeout_alarm_ != nullptr) {
+        hci_timeout_alarm_->Cancel();
+        send_next_command();
+      }
+      return;
+    }
     log::assert_that(waiting_command_ == op_code, "Waiting for {}, got {}",
                      OpCodeText(waiting_command_), OpCodeText(op_code));
 
