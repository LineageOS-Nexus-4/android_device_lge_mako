+// Mako bring-up: Linux 3.4 kernels have no eBPF support, so the pinned BPF
+// programs used by the accounting rules below can never exist.  Probe the bpf()
+// syscall once and fall back to pure iptables accounting when unavailable.
+static bool isBpfSupported() {
+    static bool probed = false;
+    static bool supported = false;
+    if (probed) return supported;
+    probed = true;
+    union bpf_attr attr = {};
+    attr.map_type = BPF_MAP_TYPE_ARRAY;
+    attr.key_size = sizeof(uint32_t);
+    attr.value_size = sizeof(uint32_t);
+    attr.max_entries = 1;
+    errno = 0;
+    int fd = syscall(__NR_bpf, BPF_MAP_CREATE, &attr, sizeof(attr));
+    if (fd >= 0) {
+        close(fd);
+        supported = true;
+    }
+    return supported;
+}
