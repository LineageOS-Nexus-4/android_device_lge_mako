diff --git a/src/gpu/ganesh/gl/AHardwareBufferGL.cpp b/src/gpu/ganesh/gl/AHardwareBufferGL.cpp
index 361ab66..c0ceba9 100644
--- a/src/gpu/ganesh/gl/AHardwareBufferGL.cpp
+++ b/src/gpu/ganesh/gl/AHardwareBufferGL.cpp
@@ -139,11 +139,28 @@ static GrBackendTexture make_gl_backend_texture(
     }
 
     EGLClientBuffer clientBuffer = eglGetNativeClientBufferANDROID(hardwareBuffer);
-    EGLint attribs[] = { EGL_IMAGE_PRESERVED_KHR, EGL_TRUE,
-                         isProtectedContent ? EGL_PROTECTED_CONTENT_EXT : EGL_NONE,
-                         isProtectedContent ? EGL_TRUE : EGL_NONE,
-                         EGL_NONE };
+    // EGL_IMAGE_PRESERVED_KHR is only valid when EGL_KHR_image_preserved is
+    // supported by the EGL implementation. Some older implementations (e.g.
+    // the Adreno driver on mako/APQ8064) do not expose the extension and
+    // reject the image with EGL_BAD_ATTRIBUTE, so only pass the attribute
+    // when it is available.
     EGLDisplay display = eglGetCurrentDisplay();
+    static const bool kSupportsImagePreserved = [] {
+        EGLDisplay dpy = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+        const char* exts = eglQueryString(dpy, EGL_EXTENSIONS);
+        return exts && strstr(exts, "EGL_KHR_image_preserved") != nullptr;
+    }();
+    EGLint attribs[5];
+    int idx = 0;
+    if (kSupportsImagePreserved) {
+        attribs[idx++] = EGL_IMAGE_PRESERVED_KHR;
+        attribs[idx++] = EGL_TRUE;
+    }
+    if (isProtectedContent) {
+        attribs[idx++] = EGL_PROTECTED_CONTENT_EXT;
+        attribs[idx++] = EGL_TRUE;
+    }
+    attribs[idx] = EGL_NONE;
     // eglCreateImageKHR will add a ref to the AHardwareBuffer
     EGLImageKHR image = eglCreateImageKHR(display, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID,
                                           clientBuffer, attribs);
