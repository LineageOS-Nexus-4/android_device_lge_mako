+void C2SoftAvcDec::convertYV12ToRGBA(const C2GraphicView &yv12, const C2GraphicView &rgba,
+                                      uint32_t width, uint32_t height) {
+    const C2PlanarLayout &lY = yv12.layout();
+    const C2PlanarLayout &lR = rgba.layout();
+    const uint8_t *const *yuvPlanes = yv12.data();
+    const uint8_t *const *rgbPlanes = rgba.data();
+    const uint8_t *yPlane = yuvPlanes[C2PlanarLayout::PLANE_Y];
+    const uint8_t *vPlane = yuvPlanes[C2PlanarLayout::PLANE_V];
+    const uint8_t *uPlane = yuvPlanes[C2PlanarLayout::PLANE_U];
+    uint32_t yStride = lY.planes[C2PlanarLayout::PLANE_Y].rowInc;
+    uint32_t vStride = lY.planes[C2PlanarLayout::PLANE_V].rowInc;
+    uint32_t uStride = lY.planes[C2PlanarLayout::PLANE_U].rowInc;
+    uint8_t *dst = const_cast<uint8_t *>(rgbPlanes[C2PlanarLayout::PLANE_Y]);
+    uint32_t dstStride = lR.planes[C2PlanarLayout::PLANE_Y].rowInc;
+    for (uint32_t row = 0; row < height; ++row) {
+        const uint8_t *yRow = yPlane + row * yStride;
+        const uint8_t *uRow = uPlane + (row >> 1) * uStride;
+        const uint8_t *vRow = vPlane + (row >> 1) * vStride;
+        uint8_t *outRow = dst + row * dstStride;
+        for (uint32_t col = 0; col < width; ++col) {
+            int32_t Y = yRow[col] - 16;
+            int32_t U = uRow[col >> 1] - 128;
+            int32_t V = vRow[col >> 1] - 128;
+            int32_t R = (298 * Y + 409 * V + 128) >> 8;
+            int32_t G = (298 * Y - 100 * U - 208 * V + 128) >> 8;
+            int32_t B = (298 * Y + 516 * U + 128) >> 8;
+            uint8_t *px = outRow + col * 4;
+            px[0] = R < 0 ? 0 : (R > 255 ? 255 : R);
+            px[1] = G < 0 ? 0 : (G > 255 ? 255 : G);
+            px[2] = B < 0 ? 0 : (B > 255 ? 255 : B);
+            px[3] = 255;
+        }
+    }
+}
