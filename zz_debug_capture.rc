# mako bring-up debug: capture kernel log to /cache (survives reboots).
# Remove once bring-up is done.
on init
    start debug_capture

on late-init
    start debug_capture

on property:sys.usb.config=mtp,adb
    start debug_capture

service debug_capture /system/bin/sh /system/bin/debug_capture.sh
    class late_start
    user root
    group root
    disabled
