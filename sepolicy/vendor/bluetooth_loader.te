# Run init.mako.bt.sh
allow bluetooth_loader vendor_shell_exec:file rx_file_perms;
allow bluetooth_loader bluetooth_loader_exec:file rx_file_perms;

# init.mako.bt.sh needs /system/bin/log access
allow bluetooth_loader devpts:chr_file rw_file_perms;

# Run hci_qcomm_init from init.mako.bt.sh
domain_auto_trans(bluetooth_loader, bluetooth_loader_exec, bluetooth_loader)
allow bluetooth_loader bluetooth_loader:fd use;

# Read mac address from persist partition
allow bluetooth_loader persist_file:dir search;
r_dir_file(bluetooth_loader, persist_bluetooth_file)

# The legacy firmware initializer reads ro.qualcomm.bt.hci_transport
# to select the SMD controller rather than the UART fallback.
get_prop(bluetooth_loader, vendor_mako_bluetooth_transport_prop)
get_prop(hal_bluetooth_default, vendor_mako_bluetooth_transport_prop)

# Exchange the factory address and controller startup state using vendor-owned
# properties. The generic helper must not write the platform bluetooth_prop.
set_prop(bluetooth_loader, vendor_mako_bluetooth_addr_prop)
set_prop(bluetooth_loader, vendor_mako_bluetooth_control_prop)
get_prop(hal_bluetooth_default, vendor_mako_bluetooth_addr_prop)
set_prop(hal_bluetooth_default, vendor_mako_bluetooth_control_prop)

# getprop, setprop, log and sleep come from the vendor toolbox and toybox.
allow bluetooth_loader vendor_toolbox_exec:file rx_file_perms;
