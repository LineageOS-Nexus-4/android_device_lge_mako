# Access /dev/msm_rotator
allow hal_graphics_composer_default video_device:chr_file rw_file_perms;

# Access /sys/devices/system/soc/soc0
r_dir_file(hal_graphics_composer_default, sysfs_socinfo)

# The legacy composer uses the Binder allocator and publishes its QService.
hal_client_domain(hal_graphics_composer_default, hal_graphics_allocator)
type mako_qdisplay_service, protected_service, hal_service_type, service_manager_type;
add_service(hal_graphics_composer_default, mako_qdisplay_service)
allow surfaceflinger mako_qdisplay_service:service_manager find;
