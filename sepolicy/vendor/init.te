# Symlink /sdcard to backing block
allow init tmpfs:lnk_file create;

allow init {
    sysfs_devices_system_cpu
    sysfs_mpdecision
    sysfs_msm_subsys
    sysfs_net
}:file w_file_perms;

allow init {
    proc_slabinfo
    sysfs_graphics
    sysfs_msm_subsys
    sysfs_usb
    sysfs_wlan_fwpath
}:file setattr;

allow init proc_last_kmsg:file { r_file_perms setattr };

# init.mako.rc execs /system/bin/ip in the netd domain to restore the
# kernel-default "from all lookup main" rule that netd flushes at boot
# (required for the data-call default route gateway validation).
allow init netd:process transition;
allow init system_file:file execute;
