# mako bring-up debug: dump logcat to /data every 10s so boot failures survive.
# Remove once bring-up is done.
on boot
    start debug_logcat

on property:sys.usb.config=mtp,adb
    start debug_logcat

service debug_logcat /system/bin/sh /system/bin/debug_logcat.sh
    class late_start
    user root
    group root
    disabled
